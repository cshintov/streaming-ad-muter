{
  "manifest_version": 2,
  "name": "Streaming Ad Muter",
  "version": "1.11",
  "description": "Automatically mutes ads on Hotstar, SonyLIV and Zee5",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.hotstar.com/*", "*://*.sonyliv.com/*", "*://*.zee5.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_action": {
    "default_title": "Streaming Ad Muter",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "streaming-ad-muter@devopsbytes.com"
    }
  }
}
