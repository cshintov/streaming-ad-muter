{
  "manifest_version": 3,
  "name": "Streaming Ad Muter",
  "version": "1.3",
  "description": "Automatically mutes ads on Hotstar and SonyLIV",
  "permissions": [
    "webRequest",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Streaming Ad Muter",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "96": "icon.png"
    }
  },
  "content_scripts": [{
    "matches": ["*://*.hotstar.com/*", "*://*.sonyliv.com/*"],
    "js": ["content.js"]
  }],
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  }
}
